# Copy this file to .env (same folder) and fill in what you have. .env is git-ignored; never commit keys.
# Restart `finmedia serve` after editing. Missing keys only switch off the feature they unlock.

# --- LLM (choose the provider in config/settings.yaml -> agent.provider) ---------------------------
# Claude (agent.provider: anthropic)
ANTHROPIC_API_KEY=
# Any OpenAI-compatible API with tool calling (agent.provider: openai_compat; set base_url + models in settings.yaml)
# e.g. Groq, OpenAI, OpenRouter, Together. A local Ollama needs no key.
OPENAI_COMPAT_API_KEY=

# --- Research data sources ------------------------------------------------------------------------
# FRED (US/global macro series). Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Web search for the researcher: ONE of these is enough (checked in this order)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# --- Alerts (optional) ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web app password (optional; required if anyone else can reach the server) ----------------------
FINMEDIA_APP_TOKEN=

# --- PTIS quant bridge (optional; default http://127.0.0.1:8010) -----------------------------------
# PTIS_BRIDGE_URL=http://127.0.0.1:8010
